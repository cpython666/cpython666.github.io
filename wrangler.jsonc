{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cpython666",
  "compatibility_date": "2026-11-12",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./docs/.vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
